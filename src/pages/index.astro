---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import GitLog from "../components/GitLog.astro";
import Terminal from "../components/Terminal.astro";
import { profile, formatYM } from "../data/profile";

const experience = await getCollection("experience");
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const education = experience.filter((e) => e.data.kind === "education");
---
<Base title={`${profile.name} · ${profile.role}`}>
  <div class="page">
    <Nav />
    <Hero />

    <section class="blk" id="experience">
      <h2>Experience<small>git log --graph</small></h2>
      <GitLog entries={experience} />
    </section>

    <section class="blk" id="projects">
      <h2>Projects</h2>
      <div class="projects">
        {projects.map(({ data: p }) => (
          <article class="proj">
            <h3>{p.url ? <a href={p.url}>{p.name} ↗</a> : p.name}</h3>
            {p.url && <div class="url mono">{p.url.replace(/^https?:\/\//, "")}</div>}
            <p>{p.summary}</p>
            <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
          </article>
        ))}
      </div>
    </section>

    <section class="blk" id="skills">
      <h2>Skills</h2>
      <div class="skills">
        {Object.entries(profile.skills).map(([group, items]) => (
          <div>
            <h3>{group}</h3>
            <div class="tags">{items.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="blk" id="education">
      <h2>Education</h2>
      <div class="edu">
        {education.map(({ data: e }) => (
          <div><b>{e.role}</b><span>{[e.org, e.where?.split(",").pop()?.trim()].filter(Boolean).join(", ")} · {formatYM(e.start)} – {formatYM(e.end)}</span></div>
        ))}
        {profile.certifications.map((c) => <div><b>{c}</b><span>Certification</span></div>)}
      </div>
    </section>

    <footer id="contact">
      <span>{profile.email} · {profile.location.split(",")[0]}</span>
      <span>Developer? Press <kbd>`</kbd> to open the terminal.</span>
    </footer>
  </div>

  <Terminal experience={experience} projects={projects} />
</Base>

<style>
  .projects { display: flex; flex-direction: column; }
  .proj { padding: 4px 0 20px; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; }
  .proj + .proj { padding-top: 18px; }
  .proj h3 { margin: 0; font-size: 19px; }
  .proj .url { font-size: 11px; color: var(--faint); }
  .proj p { margin: 0; color: var(--muted); max-width: 64ch; }
  .proj .tags { margin-top: 4px; }

  .skills { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px 32px; }
  .skills h3 { margin: 0 0 8px; font-family: var(--mono); font-size: 11.5px; font-weight: 500; color: var(--muted); letter-spacing: 0.02em; }
  .skills .tag { font-size: 11.5px; color: var(--ink); }

  .edu { display: flex; flex-direction: column; gap: 14px; }
  .edu div { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-bottom: 1px solid var(--line); padding-bottom: 14px; }
  .edu b { font-size: 17px; }
  .edu span { color: var(--muted); font-size: 14.5px; }

  footer {
    margin-top: 56px;
    border-top: 2px solid var(--rule);
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  footer kbd { color: var(--ink); }
  @media (max-width: 720px) {
    .skills { grid-template-columns: 1fr; }
  }
</style>
