---
// The dithered portrait. public/portrait.svg (made by `npm run portrait`) is used as a
// mask, so the dots take their colour from the theme and stay sharp at any size.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<div class:list={["portrait", className]} role="img" aria-label="Dithered portrait of Arjun Subedi"><span></span></div>

<style>
  .portrait { background: var(--portrait-tile); border-radius: 10px; overflow: hidden; aspect-ratio: 192 / 240; width: 100%; }
  span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--portrait-ink);
    -webkit-mask: url("/portrait.svg") center / 100% 100% no-repeat;
    mask: url("/portrait.svg") center / 100% 100% no-repeat;
  }
</style>
