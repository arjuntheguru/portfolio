---
// Experience drawn as `git log --graph`: plain HTML and SVG, no script.
// Each commit lists its parents, like git. A line runs from every commit down to each of
// its parents. When the two sit in different lanes, the line travels in the branch lane
// (the higher one) and curves into main at the end where main is: at the parent for a
// fork, at the child for a merge.
import type { CollectionEntry } from "astro:content";
import { formatYM, monthsBetween, formatDuration } from "../data/profile";

interface Props { entries: CollectionEntry<"experience">[] }
const rows = [...Astro.props.entries].sort((a, b) => a.data.commit.order - b.data.commit.order);

const LANE_GAP = 24;
const laneX = (lane: number) => 16 + lane * LANE_GAP;
const DOT_Y = 24; // centre of the commit dot from the top of its row
const CURVE_H = 28;
const lanes = Math.max(...rows.map((r) => r.data.commit.lane)) + 1;
const gutter = laneX(lanes - 1) + 16;

type Seg = { lane: number; from: "top" | "dot" | "curve"; to: "dot" | "bottom" };
type Curve = { kind: "merge" | "fork"; from: number; to: number };
const segs: Seg[][] = rows.map(() => []);
const curves: Curve[][] = rows.map(() => []);
const index = new Map(rows.map((r, i) => [r.data.commit.hash, i]));

rows.forEach((row, i) => {
  const a = row.data.commit.lane;
  for (const parent of row.data.commit.parents) {
    const j = index.get(parent);
    if (j === undefined) throw new Error(`${row.id}: parent ${parent} is not a commit in src/content/experience`);
    if (j <= i) throw new Error(`${row.id}: parent ${parent} must be further down the log (higher order)`);
    const b = rows[j].data.commit.lane;
    const t = Math.max(a, b);
    for (let k = i + 1; k < j; k++) segs[k].push({ lane: t, from: "top", to: "bottom" });
    if (a === b) {
      segs[i].push({ lane: a, from: "dot", to: "bottom" });
      segs[j].push({ lane: a, from: "top", to: "dot" });
    } else if (a === t) {
      // fork: runs down the branch lane, then curves into the parent on main
      segs[i].push({ lane: a, from: "dot", to: "bottom" });
      curves[j].push({ kind: "fork", from: a, to: b });
    } else {
      // merge: curves out of this commit into the branch lane, then down to the parent
      curves[i].push({ kind: "merge", from: a, to: t });
      segs[i].push({ lane: t, from: "curve", to: "bottom" });
      segs[j].push({ lane: t, from: "top", to: "dot" });
    }
  }
});

const y = { top: "0", dot: `${DOT_Y}px`, curve: `${DOT_Y + CURVE_H}px` };
const segStyle = (s: Seg) =>
  `left:${laneX(s.lane)}px;top:${y[s.from]};` + (s.to === "bottom" ? "bottom:0" : `height:calc(${DOT_Y}px - ${y[s.from]})`);
function curvePath(c: Curve) {
  const x1 = laneX(c.from), x2 = laneX(c.to);
  return c.kind === "merge"
    ? `M${x1} 0 C ${x1} 16, ${x2} 10, ${x2} ${CURVE_H}` // dot on main, down into the branch lane
    : `M${x1} 0 C ${x1} 12, ${x2} 8, ${x2 + (x1 > x2 ? 3 : -3)} ${DOT_Y - 6}`; // branch lane, down into the dot
}
---
<ol class="log" style={`--gutter:${gutter}px`}>
  {rows.map((entry, i) => {
    const d = entry.data;
    const c = d.commit;
    const duration = d.kind === "work" ? formatDuration(monthsBetween(d.start, d.end)) : "";
    return (
      <li class="row">
        <div class="graph" aria-hidden="true">
          {segs[i].map((s) => <i class={`line l${s.lane}`} style={segStyle(s)} />)}
          {curves[i].map((cv) => (
            <svg class={`l${Math.max(cv.from, cv.to)}`} style={`top:${cv.kind === "merge" ? DOT_Y : 0}px`} width={gutter} height={cv.kind === "merge" ? CURVE_H : DOT_Y}>
              <path d={curvePath(cv)} />
            </svg>
          ))}
          <i class={`dot l${c.lane}`} style={`left:${laneX(c.lane)}px`} />
        </div>
        <div class="entry">
          <div class="meta">
            <span class="hash">{c.hash}</span>
            <span>{c.message}</span>
            {c.refs.map((r) => <span class={`ref ${r.kind} l${c.lane}`}>{r.label}</span>)}
            <span class="when">{formatYM(d.start)} – {formatYM(d.end)}</span>
          </div>
          <h3>{d.role} <span>at</span> {d.org}</h3>
          {(d.where || duration) && <div class="where">{[d.where, duration].filter(Boolean).join(" · ")}</div>}
          {d.note && <p class="note">{d.note}</p>}
          {d.highlights.length > 0 && <ul>{d.highlights.map((h) => <li>{h}</li>)}</ul>}
          {d.tags.length > 0 && <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>}
        </div>
      </li>
    );
  })}
</ol>

<style>
  .log { list-style: none; margin: 0; padding: 0; }
  .row { display: grid; grid-template-columns: var(--gutter) 1fr; }
  .graph { position: relative; }
  .line { position: absolute; width: 2px; margin-left: -1px; background: currentColor; }
  .dot { position: absolute; top: 17px; width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: var(--bg); border: 2.5px solid currentColor; }
  svg { position: absolute; left: 0; overflow: visible; }
  path { fill: none; stroke: currentColor; stroke-width: 2; }
  .l0 { color: var(--lane0); }
  .l1 { color: var(--lane1); }
  .l2 { color: var(--lane2); }
  .l3 { color: var(--hash); }

  .entry { padding: 12px 0 22px; border-bottom: 1px solid var(--line); min-width: 0; }
  .meta { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; font-family: var(--mono); font-size: 11px; color: var(--faint); }
  .hash { color: var(--hash); }
  .ref { font-size: 10px; padding: 1px 6px; border-radius: 3px; border: 1px solid currentColor; }
  .ref.head { color: var(--good); }
  .when { margin-left: auto; color: var(--muted); }
  h3 { margin: 6px 0 0; font-size: 20px; line-height: 1.3; font-weight: 700; }
  h3 span { font-weight: 400; color: var(--muted); }
  .where { font-size: 14px; color: var(--muted); }
  .note { margin: 10px 0 0; max-width: 68ch; font-style: italic; color: var(--muted); }
  ul { margin: 10px 0 0; padding-left: 18px; display: flex; flex-direction: column; gap: 5px; max-width: 68ch; }
  .tags { margin-top: 12px; }
  @media (max-width: 720px) {
    .when { margin-left: 0; width: 100%; }
  }
</style>
