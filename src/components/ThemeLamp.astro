---
// Light/dark toggle drawn as a bulb hanging from the top of the page on an elastic cord.
// Pull it down (drag, click, tap, Enter or Space) to flip the theme; drag it sideways
// and let go to set it swinging. Physics lives in src/scripts/lamp.ts.
// The bulb is lit in light mode and off in dark. Follows the OS until the visitor pulls it.
---
<span class="mount">
  <button class="lamp" id="theme-lamp" type="button" role="switch" aria-checked="false" aria-label="Dark mode" title="Pull for dark mode">
    <svg viewBox="0 0 40 92" aria-hidden="true">
      <defs>
        <radialGradient id="lamp-glow">
          <stop offset="0" stop-color="#ffd257" stop-opacity="0.55" />
          <stop offset="1" stop-color="#ffd257" stop-opacity="0" />
        </radialGradient>
      </defs>
      <!-- The cord runs from the anchor at the top edge to wherever the bulb is. -->
      <path class="cord" data-cord d="M20 0Q20 24 20 48" />
      <!-- Bulb drawn around its own origin (the top of the cap), moved and turned by script. -->
      <g class="bulb" data-bulb transform="translate(20 48)">
        <circle class="glow" cx="0" cy="24" r="20" fill="url(#lamp-glow)" />
        <rect class="cap" x="-5" y="-1" width="10" height="9" rx="1.5" />
        <path class="thread" d="M-5 2.5h10M-5 5.5h10" />
        <path class="glass" d="M-4.5 8 C-4.5 12 -11 14.5 -11 22 A11 11 0 0 0 11 22 C11 14.5 4.5 12 4.5 8 Z" />
        <path class="filament" d="M-3 12 L-2 18.5 L0 15 L2 18.5 L3 12" />
      </g>
    </svg>
  </button>
</span>

<style>
  /* Takes no room in the nav; the lamp hangs from the very top of the page. */
  .mount { position: relative; width: 40px; height: 1px; flex: none; }
  .lamp {
    all: unset;
    cursor: grab;
    position: absolute;
    left: 0;
    top: -32px; /* nav padding plus half the nav line: the cord starts at the top edge */
    width: 40px;
    height: 92px;
    touch-action: none; /* dragging the bulb shouldn't scroll the page */
    -webkit-tap-highlight-color: transparent;
  }
  .lamp.dragging { cursor: grabbing; }
  .lamp:focus-visible { outline: 2px solid var(--lane1); outline-offset: 2px; border-radius: 6px; }
  svg { display: block; width: 100%; height: 100%; overflow: visible; }

  .cord { fill: none; stroke: var(--muted); stroke-width: 1.4; stroke-linecap: round; }
  .cap { fill: var(--ink); }
  .thread { stroke: var(--bg); stroke-width: 0.8; opacity: 0.6; }

  /* Lit in light mode, an unlit outline in dark (tokens in global.css), so it's right before any script runs. */
  .glass { fill: var(--bulb-glass); stroke: var(--bulb-edge); stroke-width: 1.5; transition: fill 0.25s, stroke 0.25s; }
  .filament { fill: none; stroke: var(--bulb-filament); stroke-width: 1.1; stroke-linejoin: round; transition: stroke 0.25s; }
  .glow { opacity: var(--bulb-glow); transition: opacity 0.35s; }
</style>

<script>
  import { mountLamp } from "../scripts/lamp";
  mountLamp();
</script>
