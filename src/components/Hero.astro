---
import Portrait from "./Portrait.astro";
import { profile } from "../data/profile";
const [first, ...rest] = profile.name.split(" ");
---
<header class="hero">
  <h1>{first}<br />{rest.join(" ")}</h1>
  <div class="text">
    <p class="role">{profile.role} at {profile.employer}<span class="loc"><span class="dot"> · </span>{profile.location}</span></p>
    <p class="bio">{profile.bio}</p>
    <div class="contact">
      <a class="link" href={`mailto:${profile.email}`} aria-label={`Email ${profile.email}`}><span class="full">{profile.email}</span><span class="short">Email</span></a>
      <button class="copy" type="button" data-copy={profile.email}>copy</button>
      <span class="pair"><span class="sep" aria-hidden="true">/</span><a class="link" href={profile.links.linkedin} rel="me">LinkedIn ↗</a></span>
      <span class="pair"><span class="sep" aria-hidden="true">/</span><a class="link" href={profile.links.github} rel="me">GitHub ↗</a></span>
    </div>
  </div>
  <Portrait class="pic" />
</header>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 240px;
    grid-template-areas: "name pic" "text pic";
    column-gap: 48px;
    row-gap: 14px;
    align-items: end;
    padding-block: 44px 40px;
    border-bottom: 2px solid var(--rule);
  }
  h1 {
    grid-area: name;
    margin: 0;
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(34px, 6vw, 64px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .text { grid-area: text; align-self: start; }
  .hero :global(.pic) { grid-area: pic; }
  .role { margin: 0; font-size: 19px; font-weight: 500; }
  .loc { color: var(--muted); font-weight: 400; }
  .short { display: none; }
  .bio { margin: 10px 0 0; max-width: 56ch; color: var(--muted); }
  .contact { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; margin-top: 20px; font-family: var(--mono); font-size: 12.5px; }
  .pair { display: inline-flex; gap: 14px; white-space: nowrap; } /* keeps each "/" with the link after it */
  .sep { color: var(--faint); }
  .copy {
    all: unset;
    cursor: pointer;
    color: var(--muted);
    font-size: 11px;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 2px 7px;
  }
  .copy:hover { color: var(--ink); border-color: var(--ink); }
  .copy:focus-visible { outline: 2px solid var(--lane1); outline-offset: 2px; }

  /* Phones and small tablets: the portrait sits beside the name as one header block, and
     the contact links become a row of three equal buttons. */
  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 104px 1fr;
      grid-template-areas: "pic name" "text text";
      column-gap: 18px;
      row-gap: 20px;
      align-items: end;
      padding-block: 16px 32px;
    }
    h1 { font-size: clamp(34px, 10.5vw, 52px); }
    .role { font-size: 17px; }
    .loc { display: block; margin-top: 2px; font-size: 15px; }
    .dot { display: none; }
    .bio { font-size: 15.5px; }
    .contact { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 18px; font-size: 12px; }
    .pair { display: contents; }
    .sep, .copy { display: none; }
    .link {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding-inline: 6px;
      border: 1px solid var(--line);
      border-radius: 8px;
      white-space: nowrap;
    }
    .link:hover, .link:active { border-color: var(--ink); }
    .full { display: none; }
    .short { display: inline; }
  }
</style>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = "copied ✓";
        setTimeout(() => (btn.textContent = "copy"), 1600);
      } catch {
        // Clipboard refused (old browser or insecure context): the address is visible anyway.
      }
    });
  }
</script>
